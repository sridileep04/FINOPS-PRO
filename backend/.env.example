# --- Postgres ---
DB_USER=finops
DB_PASSWORD=change-me-strong-password
DB_NAME=finops
DB_PORT=5432
DB_HOST=localhost

# --- Redis ---
REDIS_PORT=6379

# --- App secrets ---
# Used for signing JWTs. Generate with: openssl rand -hex 32
SECRET_KEY=change-me-jwt-secret
MIN_PASSWORD_LENGTH=10

# --- Credential encryption --- (see backend/app/core/encryption.py)
# "fernet": simple, works everywhere, key managed by you.
# "kms": recommended for real production -- see README "Enterprise
#        hardening" section. Requires CREDENTIAL_KMS_KEY_ID instead.
ENCRYPTION_BACKEND=fernet
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=change-me-fernet-key
# Only used if ENCRYPTION_BACKEND=kms -- a KMS key ID or ARN, e.g.
# arn:aws:kms:us-east-1:123456789012:key/xxxxxxxx-xxxx-...
CREDENTIAL_KMS_KEY_ID=

ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Steampipe microservice ---
# Shared secret the backend presents to steampipe-service on every call.
# Generate with: openssl rand -hex 32
# This is the ONLY thing standing between "internal service" and "anyone
# who reaches this port can run AWS API calls with any credentials they
# supply" -- treat it like a production database password.
STEAMPIPE_SERVICE_TOKEN=change-me-service-token

# Pin a specific Steampipe release for reproducible builds (check
# https://github.com/turbot/steampipe/releases). "latest" always pulls
# the newest release instead.
STEAMPIPE_VERSION=latest
STEAMPIPE_QUERY_TIMEOUT_SECONDS=300
STEAMPIPE_MAX_CONCURRENT_QUERIES=8
# Only used for local dev where the backend runs natively on the host
# instead of in Docker (see README "Local development" / test.md).
STEAMPIPE_SERVICE_PORT=8001

# --- Platform's own AWS identity (used for assuming customer cross-account
# roles, both by steampipe-service and by the backend's permission-check
# probes). Leave both blank to use the container's own ECS task role / EC2
# instance profile instead -- the recommended production setup, since then
# no long-lived platform AWS key exists anywhere.
PLATFORM_AWS_ACCESS_KEY_ID=
PLATFORM_AWS_SECRET_ACCESS_KEY=
# One of: Environment | Ec2InstanceMetadata | EcsContainer
PLATFORM_CREDENTIAL_SOURCE=EcsContainer

# --- Misc ---
# "development" during active work on this project (this repo's own
# README says the backend is still being built out) -- switch to
# "production" before a real deploy, which also turns SEED_DEMO_USERS
# off automatically unless you set it explicitly below.
ENVIRONMENT=development
# Creates admin@ghostfinops.com / viewer@ghostfinops.com (both
# password123) on startup -- the exact credentials the login screen
# advertises. Leave unset to auto-follow ENVIRONMENT (on outside prod,
# off in prod); set explicitly to override either way.
SEED_DEMO_USERS=true
API_WORKERS=2
WORKER_CONCURRENCY=4
# Set to your real frontend origin(s), comma-separated, before going
# live -- "*" combined with credentialed requests effectively trusts any
# origin. The backend logs a warning at startup if this is still "*"
# while ENVIRONMENT=production.
CORS_ORIGINS=*
