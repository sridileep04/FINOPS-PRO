# Copy to `.env` (gitignored) and fill in real values before running
# `docker compose up`. Every value here is a placeholder -- see the
# leaked-secret findings in backend/tests/security/AUDIT.md for exactly
# why committing a real value in this file's place is a bad idea.

# --- Postgres ---
POSTGRES_USER=finopsuser
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=finopsdb

# --- Backend app secrets ---
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-jwt-secret
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=change-me-fernet-key
# Generate with: openssl rand -hex 32 -- shared secret between backend and steampipe-service
STEAMPIPE_SERVICE_TOKEN=change-me-service-token

# --- LLM (AI copilot) ---
GROQ_API_KEY=your_key_here

# --- Environment ---
ENVIRONMENT=production
SEED_DEMO_USERS=false
CORS_ORIGINS=https://your-real-frontend-domain.example.com
